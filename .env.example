# ============================================================
# Smart Plant Manager - Example Environment Configuration
# ============================================================
# Copy this file to .env and replace the placeholder values:
#   copy .env.example .env
# ============================================================

# Database Configuration (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASS=your_mysql_password_here
DB_NAME=plant

# Groq AI Settings (Get your free key from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Server Port
PORT=9000

# Backend Bridge Server (bridge.js)
BRIDGE_PORT=3000
C_SERVER=http://localhost:9000
